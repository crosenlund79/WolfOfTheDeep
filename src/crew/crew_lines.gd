class_name CrewLines
extends RefCounted
## Everyday crew speech (no story content). `where`: control / mess / engine /
## any. `mood`: calm lines are only used when nothing is happening.
## Voice: a line may name a voice recording (vo_*); others are subtitles only.
## Creator's note: add recorded lines by dropping custom/audio/line_<id>.ogg.

const AMBIENT := [
	{"id": "mil_a1", "who": "miller", "where": "control", "text": "Quiet watch. I've learned to distrust those."},
	{"id": "mil_a2", "who": "miller", "where": "control", "text": "Helm, steady. Nice and easy. No prizes for heroics up here."},
	{"id": "mil_a3", "who": "miller", "where": "any", "text": "Thirty years at sea and the Arctic still finds new ways to surprise me. Mostly unpleasantly."},
	{"id": "mil_a4", "who": "miller", "where": "control", "text": "Maya, give me the ice picture for the next six hours when you've a moment."},
	{"id": "mil_a5", "who": "miller", "where": "control", "night": true, "text": "Night watch. My favourite. Nobody asks me anything."},
	{"id": "mil_a6", "who": "miller", "where": "mess", "text": "If you're after the coffee, Captain, I'd lower your expectations first."},
	{"id": "mil_a7", "who": "miller", "where": "control", "text": "Log the barometer, please. Falling slowly. I don't like slowly."},
	{"id": "bas_a1", "who": "basse", "where": "mess", "text": "Hvem har rørt min lakrids? Somebody touched my liquorice. I can tell."},
	{"id": "bas_a2", "who": "basse", "where": "mess", "text": "Coffee is fresh. Well. It is hot. Hot is the important part."},
	{"id": "bas_a3", "who": "basse", "where": "mess", "text": "For helvede... the oven again."},
	{"id": "bas_a4", "who": "basse", "where": "mess", "text": "Twenty-two years on merchant ships and never once a galley this small. You cook sideways."},
	{"id": "bas_a5", "who": "basse", "where": "mess", "text": "You eat, you sleep, you do your job. The sea does not care if you are hungry. I do."},
	{"id": "bas_a6", "who": "basse", "where": "mess", "text": "In Nyhavn they would laugh at this kitchen. Then they would eat everything."},
	{"id": "bas_a7", "who": "basse", "where": "mess", "text": "Skide godt. That one came out right. Don't tell anyone, they'll expect it every day."},
	{"id": "bas_a8", "who": "basse", "where": "mess", "night": true, "text": "Night baking. Bread doesn't know what time it is. Neither do I, down here."},
	{"id": "fre_a1", "who": "freja", "where": "control", "text": "Biologics on the array. Seals, I think. They talk too much."},
	{"id": "fre_a2", "who": "freja", "where": "control", "text": "It's quiet. Quiet isn't the same as empty, though."},
	{"id": "fre_a3", "who": "freja", "where": "control", "text": "Background noise is up. Sea state, mostly. I can live with it."},
	{"id": "fre_a4", "who": "freja", "where": "control", "text": "Could someone close that hatch more gently? It looks like a torpedo door on my display."},
	{"id": "fre_a5", "who": "freja", "where": "any", "text": "I'd rather say 'I don't know yet' than be wrong with confidence."},
	{"id": "fre_a6", "who": "freja", "where": "control", "text": "The ice talks, if you listen long enough. Mostly it complains."},
	{"id": "fre_a7", "who": "freja", "where": "mess", "text": "Lagom. Not too much, not too little. That's how you listen. And how you drink coffee."},
	{"id": "eri_a1", "who": "erik", "where": "engine", "text": "She runs fine. Don't let anyone tell you otherwise."},
	{"id": "eri_a2", "who": "erik", "where": "any", "text": "Slow and quiet is cheap. Fast is expensive. Remember that, Captain."},
	{"id": "eri_a3", "who": "erik", "where": "engine", "text": "I told the yard the bearing on the number two pump was tired. They said it was fine. It is not fine."},
	{"id": "eri_a4", "who": "erik", "where": "mess", "text": "Basse can have his oven when the galley stops tripping my breakers. Simple."},
	{"id": "eri_a5", "who": "erik", "where": "engine", "text": "Cold water is good for the plant. Bad for my knees."},
	{"id": "eri_a6", "who": "erik", "where": "engine", "text": "From Tromsø to here, every boat I served on had a rattle. This one hides hers better."},
	{"id": "may_a1", "who": "maya", "where": "control", "text": "Updated the ice chart. The edge is creeping south again."},
	{"id": "may_a2", "who": "maya", "where": "control", "text": "Charts up here are... optimistic. I trust the echo sounder over the paper."},
	{"id": "may_a3", "who": "maya", "where": "mess", "text": "Studying for the command exam. Chapter three. Again. Don't tell Miller."},
	{"id": "may_a4", "who": "maya", "where": "any", "text": "Back home in Halifax this would count as a mild October."},
	{"id": "may_a5", "who": "maya", "where": "control", "text": "Current's setting us east about half a knot. I've allowed for it."},
	{"id": "may_a6", "who": "maya", "where": "control", "night": true, "text": "Funny. Twelve hours of darkness and I still keep checking for the sun."},
	{"id": "has_a1", "who": "haugen", "where": "control", "text": "Sonar, steady. Nothing new, sir."},
	{"id": "ras_a1", "who": "rask", "where": "control", "text": "Steady on course, sir. She's handling nicely."},
]

const CONVERSATIONS := [
	{"id": "c_oven", "where": "mess", "lines": [["basse", "Erik. My oven died again. In the middle of the bread."], ["erik", "Your oven draws like a frigate. The breaker is doing its job."], ["basse", "Then fix the breaker so it does a different job."], ["erik", "...I'll look at it after dinner. If the bread is good."]]},
	{"id": "c_sleep", "where": "any", "lines": [["maya", "Did you sleep at all last night?"], ["freja", "Some. The array was busy. Ice moving to the north."], ["maya", "That's not sleep, Freja."], ["freja", "It's close enough."]]},
	{"id": "c_worry", "where": "control", "lines": [["miller", "Maya. If you had the conn right now, what's your first worry?"], ["maya", "The ice to the north. Then the traffic on the bank."], ["miller", "Good. Most people only keep one worry. That's how they meet the second one."]]},
	{"id": "c_bread", "where": "mess", "lines": [["basse", "Here. Rye bread. Don't argue."], ["freja", "I wasn't going to."], ["basse", "Everybody argues. Then they eat."]]},
	{"id": "c_hanger", "where": "any", "lines": [["erik", "Remember the Nordkapp exercise? Six days, and the generator—"], ["miller", "I remember you fixing it with a coat hanger."], ["erik", "Spring steel. It was spring steel."], ["miller", "It was a coat hanger, Erik."]]},
	{"id": "c_battery", "where": "control", "lines": [["maya", "Chief, how long on the battery at four knots?"], ["erik", "Long enough. Ask me again at twelve knots and I'll be less cheerful."]]},
	{"id": "c_coffee", "where": "mess", "lines": [["basse", "Miller. You want the good coffee or the normal coffee?"], ["miller", "There's a good coffee?"], ["basse", "No. But I like to give people hope."]]},
	{"id": "c_rattle", "where": "control", "lines": [["freja", "Chief, something rattles aft. Starboard side, about one hertz."], ["erik", "That's the pump I keep complaining about."], ["freja", "Then please keep complaining. To someone who can fix it."]]},
	{"id": "c_meal", "where": "mess", "meal": true, "lines": [["maya", "This is good, Basse."], ["basse", "Of course it's good. You're hungry. Hunger is the best cook. I am second."]]},
	{"id": "c_candy", "where": "mess", "evening": true, "lines": [["erik", "Cards tonight? I want my chocolate back from Freja."], ["freja", "You lost it fairly, Chief."], ["basse", "Bet the toffee like civilised people. Nobody touches the liquorice."]]},
	{"id": "c_home", "where": "mess", "lines": [["maya", "What's the first thing you do when we get in?"], ["erik", "Sleep for two days."], ["basse", "Cook something that does not fit in a submarine."], ["maya", "Like what?"], ["basse", "A whole goose. Out of spite."]]},
	{"id": "c_quiet", "where": "control", "night": true, "lines": [["rask", "Sir, does it ever feel strange, being this far from anyone?"], ["miller", "Every time. That's how you know you're paying attention."]]},
	{"id": "c_exam", "where": "mess", "lines": [["miller", "How's the studying?"], ["maya", "Rules of the road, chapter three. It hates me."], ["miller", "It hates everyone. Pass it anyway."]]},
	{"id": "c_ears", "where": "mess", "lines": [["basse", "Freja, you have the headphones even here?"], ["freja", "They're not plugged in."], ["basse", "Then why?"], ["freja", "Habit. It's quieter."]]},
]

